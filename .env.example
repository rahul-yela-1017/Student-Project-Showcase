# ---- Primary datastore: the existing student_project_showcase MongoDB ----
# (MongoDB Atlas or a local cluster). Server-side only — never exposed to the browser.
MONGODB_URI="mongodb+srv://<user>:<password>@cluster0.<cluster-id>.mongodb.net/?appName=Cluster0"

# ---- Authentication ----
# Long random secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# Set to "true" when serving the app over HTTPS (production).
COOKIE_SECURE=false

